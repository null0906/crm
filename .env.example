# ─── Database (Railway provides this automatically when you add a Postgres service) ───
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_POOL_MAX=10

# ─── Auth ────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-generated-secret
# Set to your Railway public domain after first deploy
NEXTAUTH_URL=https://your-app.up.railway.app
BCRYPT_ROUNDS=12

# ─── App ─────────────────────────────────────────────────────────────────────────
APP_NAME=SecComply Command Center
APP_URL=https://your-app.up.railway.app
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# ─── Gemini AI Assistant ─────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.1

# ─── File Storage ────────────────────────────────────────────────────────────────
# Use 'local' for Railway volume, or 's3' for AWS S3 / Cloudflare R2
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# Uncomment and fill if using S3 / Cloudflare R2:
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=seccomply-uploads
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ─── Redis (not currently used, safe to leave blank) ─────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── Email (Resend recommended) ──────────────────────────────────────────────────
# Verify your sending domain/address in Resend, then use:
# RESEND_API_KEY=re_xxx
# RESEND_FROM=SecComply <atharva@seccomply.net>
# RESEND_REPLY_TO=atharva@seccomply.net

# ─── Telegram Bot ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
TELEGRAM_MODE=webhook

# ─── WhatsApp Bot (Meta Cloud API) ────────────────────────────
# From Meta for Developers > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# From App Settings > Basic > App Secret — used to verify incoming webhook signatures
WHATSAPP_APP_SECRET=your-meta-app-secret
# Any string you choose — enter the same value when configuring the webhook in Meta's dashboard
WHATSAPP_VERIFY_TOKEN=replace-with-openssl-rand-hex-32
WHATSAPP_API_VERSION=v21.0

# ─── Microsoft Teams Bot ───────────────────────────────────────
# From the Azure Bot resource's paired Microsoft Entra ID app registration
# (Azure Portal > Azure Bot > Configuration > Microsoft App ID)
TEAMS_BOT_APP_ID=00000000-0000-0000-0000-000000000000
# Generate under the app registration's "Certificates & secrets" blade
TEAMS_BOT_APP_PASSWORD=your-client-secret-value
# Your Microsoft 365 tenant ID (Azure AD > Overview > Tenant ID)
TEAMS_BOT_TENANT_ID=00000000-0000-0000-0000-000000000000

# ─── Email / Digest ────────────────────────────────────────
RESEND_API_KEY=re_xxx
RESEND_FROM=SecComply <noreply@seccomply.net>
RESEND_REPLY_TO=founder@seccomply.net

# Optional SMTP fallback
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=SecComply <noreply@seccomply.net>
